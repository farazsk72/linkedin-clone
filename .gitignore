# Local-only Spring profiles holding real credentials. Never commit these.
**/src/main/resources/application-local.properties
**/src/main/resources/application-local.yml
**/src/main/resources/application-local.yaml

# Aggregated log files (shipped to Loki), keep the dir but not the logs.
# Covers live logs and rotated/gzipped ones (e.g. posts-service.log.2026-07-23.0.gz).
/logs/*.log
/logs/*.log.*
/logs/*.gz

# Local filesystem uploads (uploader.backend=local). Never commit stored files.
**/uploads-data/
